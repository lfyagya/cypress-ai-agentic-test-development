node_modules/
cypress/videos/
cypress/screenshots/
cypress/downloads/
cypress/reports/
reports/
cypress.env.json
.env
output/

# Generated local/CI evidence; keep evidence/requirements.json tracked.
evidence/runs/
evidence/coverage-computed.json
evidence/metrics.json

# Generated skill installs outside the two harness projections. Prefer .claude/skills and
# .agents/skills (generated by harness:sync from harness/skills). These paths are stale/wrong.
.cursor/skills/
.github/skills/
.codex/skills/

# GSD Core runtime. Installed per person by `node scripts/engine/install-gsd.mjs` (CI runs it too);
# it writes machine-specific paths, so it is never committed.
/.*/gsd-core/
/.*/gsd-migration-journal/
/.*/gsd-file-manifest.json
/.*/gsd-install-state.json
/.*/.gsd-profile
/.*/agents/gsd-*
/.*/commands/gsd-*
/.*/hooks/gsd-*
/.*/hooks/lib/
/.*/skills/gsd-*
/.claude/scripts/
/.cursor/scripts/
/.codex/scripts/
/.github/scripts/
/.codex/config.toml
/.codex/hooks.json
/.*/hooks/managed-hooks-registry.cjs
/.*/hooks/package.json
/.gsd/
/.gsd-capabilities.json
